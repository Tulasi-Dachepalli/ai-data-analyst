# Copy this file to .env — these values stay on the server, never sent to the browser.
ANTHROPIC_API_KEY=your_api_key_here

# Long random string used to sign login sessions (JWTs). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Postgres connection string.
# Local dev (with the included docker-compose.yml):
DATABASE_URL=postgresql://aida:aida@localhost:5432/aida
# Hosted providers (Render/Neon/Supabase/RDS) give you one that looks like:
# postgresql://user:password@host:5432/dbname

# SSL for the Postgres connection. Leave unset to auto-detect (off for
# localhost, on for anything else). Set explicitly if your provider needs
# the opposite of the default.
# PGSSL=true

# Origin(s) allowed to call this backend. Comma-separate multiple origins —
# useful in production if you have a main domain plus preview deployment
# URLs (e.g. "https://app.example.com,https://staging.example.com").
ALLOWED_ORIGIN=http://localhost:5173

# Port the backend listens on
PORT=3001

# Resend (https://resend.com) sends verification and password-reset emails.
# Leave RESEND_API_KEY unset for local dev — emails are logged to the
# console instead of sent, so you can copy the token/link out of the logs.
RESEND_API_KEY=
# Must be a domain you've verified in Resend, or their shared test sender
# (onboarding@resend.dev) which only works for the account owner's own
# email — fine for local testing, not for real users.
RESEND_FROM_EMAIL=AI Data Analyst <onboarding@resend.dev>

# Used to build links inside emails. FRONTEND_URL is where the "reset
# password" link points (your Vite app); BACKEND_URL is where the "verify
# email" link points (this server, since verification is handled directly
# here — see routes/auth.js).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Cost estimation for the admin usage dashboard (USD per million tokens).
# NOT set to real numbers here on purpose — model pricing changes over time
# and these values were not verified against a live pricing page. Check
# https://www.anthropic.com/pricing for the current rate for whichever
# model routes/analyze.js is calling, then fill these in. Left unset,
# estimated_cost is stored as 0 — token counts are still tracked accurately
# either way, so nothing breaks by leaving this blank.
CLAUDE_INPUT_COST_PER_MTOK=
CLAUDE_OUTPUT_COST_PER_MTOK=
