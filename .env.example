# The frontend no longer needs an API key — that now lives in backend/.env
# and never reaches the browser.
#
# Leave VITE_API_BASE_URL unset for local dev (the Vite proxy in vite.config.js
# forwards /api/* to the backend on http://localhost:3001).
#
# Set it only if you deploy the frontend and backend on different domains —
# which is the normal case in production (frontend on Vercel, backend on
# Render). Point it at your backend's public URL, e.g.:
# VITE_API_BASE_URL=https://ai-data-analyst-backend.onrender.com
